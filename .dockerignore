!Cargo.lock
!build.rs
!.cargo/
!.cargo/config.toml
!src/
!src/**
!ui/
!ui/**
!resources/
!resources/**
!THIRD_PARTY_NOTICES.txt
!scripts/
!scripts/package-release.py
