{
  "name": "scheduled-screenshot-ui",
  "private": true,
  "scripts": {
    "build:css": "tailwindcss -i ui/tailwind.css -o ui/style.css --minify",
    "watch:css": "tailwindcss -i ui/tailwind.css -o ui/style.css --watch",
    "check:css": "node scripts/check-styles.cjs",
    "test:browser": "node tests/browser/run.cjs"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "playwright": "1.64.1",
    "tailwindcss": "4.3.3"
  },
  "overrides": {
    "@parcel/watcher": "2.6.0"
  }
}
