+'use strict';
+
+const assert = require('node:assert/strict');
+const fs = require('node:fs/promises');
+const path = require('node:path');
+const { pathToFileURL } = require('node:url');
+const { chromium } = require(process.env.PLAYWRIGHT_MODULE || 'playwright');
+
+async function main() {
+  const artifacts = path.join(__dirname, 'artifacts');
+  await fs.mkdir(artifacts, { recursive: true });
+  const browser = await chromium.launch({ headless: true, executablePath: process.env.CHROME_PATH || undefined });
+  try {
+    const page = await browser.newPage();
+    const errors = [];
+    page.on('pageerror', error => errors.push(error.message));
+    await page.goto(pathToFileURL(path.resolve(__dirname, '../../../src/ScheduledScreenshot/config-editor.html')).href);
+    await page.locator('#addTask').click();
+    const output = page.locator('#task-capture-outputFolder');
+    const original = await output.inputValue();
+    const browse = page.locator('#browseOutputFolder');
+    const dialog = page.locator('#folderDialog');
+
+    // The OS picker cannot run headlessly; simulate only its public API result.
+    await page.evaluate(() => { window.showDirectoryPicker = async () => { throw new DOMException('Cancelled', 'AbortError'); }; });
+    await browse.click();
+    assert.equal(await dialog.isVisible(), false);
+    assert.equal(await output.inputValue(), original);
+
+    await page.evaluate(() => {
+      window.showDirectoryPicker = async options => {
+        window.pickerOptions = options;
+        return { name: 'Screenshots & photos' };
+      };
+    });
+    await browse.click();
+    await dialog.waitFor({ state: 'visible' });
+    assert.match(await page.locator('#folderDialogNote').textContent(), /Screenshots & photos/);
+    assert.equal(await page.locator('#folderFullPath').inputValue(), '');
+    assert.equal(await output.inputValue(), original, 'A bare folder name must not replace the configured path.');
+    assert.equal(await page.evaluate(() => window.pickerOptions.mode), 'read');
+    await page.locator('#folderFullPath').fill('Screenshots & photos');
+    await page.locator('#applyFolder').click();
+    assert.equal(await dialog.isVisible(), true, 'Relative folder names must be rejected in the confirmation dialog.');
+    const chosen = 'C:\\Pictures\\Screenshots & photos';
+    await page.locator('#folderFullPath').fill(`"${chosen}"`);
+    await page.locator('#applyFolder').click();
+    assert.equal(await output.inputValue(), chosen);
+
+    await browse.click();
+    await dialog.waitFor({ state: 'visible' });
+    await page.locator('#folderFullPath').fill('C:\\Cancelled');
+    await page.keyboard.press('Escape');
+    assert.equal(await output.inputValue(), chosen);
+
+    await page.evaluate(() => { window.showDirectoryPicker = undefined; });
+    await browse.click();
+    await dialog.waitFor({ state: 'visible' });
+    assert.match(await page.locator('#folderDialogNote').textContent(), /unavailable/);
+    await page.locator('#folderFullPath').fill('/Users/example/Pictures');
+    await page.locator('#cancelFolder').click();
+    assert.equal(await output.inputValue(), chosen);
+
+    await page.setViewportSize({ width: 390, height: 844 });
+    await browse.click();
+    await dialog.waitFor({ state: 'visible' });
+    assert.equal(await page.evaluate(() => document.documentElement.scrollWidth <= innerWidth), true);
+    await page.screenshot({ path: path.join(artifacts, 'folder-dialog-mobile.png') });
+    await page.locator('#cancelFolder').click();
+    await page.setViewportSize({ width: 1280, height: 1000 });
+    await output.scrollIntoViewIfNeeded();
+    await page.screenshot({ path: path.join(artifacts, 'output-folder-desktop.png') });
+
+    const downloadReady = page.waitForEvent('download');
+    await page.locator('#downloadButton').click();
+    const download = await downloadReady;
+    const settingsPath = path.join(artifacts, 'settings.json');
+    await download.saveAs(settingsPath);
+    const settings = JSON.parse(await fs.readFile(settingsPath, 'utf8'));
+    assert.equal(settings.tasks[0].capture.outputFolder, chosen);
+    assert.deepEqual(errors, []);
+    console.log('Output folder browser checks passed: picker selection, cancellation, full-path validation, fallback, mobile layout, and JSON export.');
+  } finally {
+    await browser.close();
+  }
+}
+
+main().catch(error => { console.error(error); process.exitCode = 1; });
