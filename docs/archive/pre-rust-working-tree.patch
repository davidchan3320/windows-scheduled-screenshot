+using System;
+using System.Reflection;
+using System.Threading;
+using System.Threading.Tasks;
+
+// Compiled against .NET Framework for the browser/real-loopback integration check.
+public static class HostHarness
+{
+    public static void Main(string[] args)
+    {
+        var assembly = Assembly.LoadFrom(args[0]);
+        using (var logger = (IDisposable)Activator.CreateInstance(
+            assembly.GetType("ScheduledScreenshot.Services.DiagnosticLogger"), new object[] { args[1] }))
+        {
+            var calls = 0;
+            Func<Task<string>> choose = async () =>
+            {
+                await Task.Delay(100);
+                return Interlocked.Increment(ref calls) == 1 ? args[2] : null;
+            };
+            using (var host = (IDisposable)Activator.CreateInstance(
+                assembly.GetType("ScheduledScreenshot.Services.EditorHost"),
+                new object[] { args[3], choose, logger }))
+            {
+                Console.WriteLine(host.GetType().GetProperty("Url").GetValue(host));
+                Console.ReadLine();
+            }
+        }
+    }
+}
