@@ -0,0 +1,60 @@
+'use strict';
+
+const assert = require('node:assert/strict');
+const path = require('node:path');
+const fs = require('node:fs/promises');
+const { spawn } = require('node:child_process');
+const readline = require('node:readline');
+const { chromium } = require(process.env.PLAYWRIGHT_MODULE || 'playwright');
+
+async function main() {
+  const root = path.resolve(__dirname, '../../..');
+  const artifacts = path.join(__dirname, 'artifacts', 'host');
+  await fs.mkdir(artifacts, { recursive: true });
+  const chosen = path.join(artifacts, 'Selected screenshots');
+  await fs.mkdir(chosen, { recursive: true });
+  const harness = spawn(process.env.HOST_HARNESS, [process.env.APP_ASSEMBLY, artifacts, chosen,
+    path.join(root, 'src/ScheduledScreenshot/config-editor.html')], { windowsHide: true, stdio: ['pipe', 'pipe', 'inherit'] });
+  let browser;
+  try {
+    const url = await new Promise((resolve, reject) => {
+      const timeout = setTimeout(() => reject(new Error('Editor host did not start.')), 10000);
+      harness.once('error', error => { clearTimeout(timeout); reject(error); });
+      harness.once('exit', code => { clearTimeout(timeout); reject(new Error(`Host exited: ${code}`)); });
+      readline.createInterface({ input: harness.stdout }).once('line', line => { clearTimeout(timeout); resolve(line); });
+    });
+    const address = new URL(url);
+    const token = new URLSearchParams(address.hash.slice(1)).get('folderToken');
+    const endpoint = address.origin + '/api/output-folder';
+    const denied = await fetch(endpoint, { method: 'POST', headers: { Origin: address.origin } });
+    assert.equal(denied.status, 403);
+    const crossOrigin = await fetch(endpoint, { method: 'POST', headers: { Origin: 'https://example.com', 'X-Editor-Token': token } });
+    assert.equal(crossOrigin.status, 403);
+    assert.equal((await fetch(endpoint)).status, 404);
+
+    browser = await chromium.launch({ headless: true, executablePath: process.env.CHROME_PATH || undefined });
+    const page = await browser.newPage();
+    await page.goto(url);
+    await page.locator('#addTask').click();
+    await page.locator('#browseOutputFolder').click();
+    await page.waitForFunction(expected => document.getElementById('task-capture-outputFolder').value === expected, chosen);
+    assert.equal(await page.locator('#folderDialog').isVisible(), false);
+    assert.match(await page.locator('#fileState').textContent(), /Output folder updated/);
+    await page.locator('#browseOutputFolder').click();
+    await page.waitForFunction(() => !document.getElementById('browseOutputFolder').disabled);
+    assert.equal(await page.locator('#task-capture-outputFolder').inputValue(), chosen, 'Cancel must preserve the path.');
+    const downloaded = page.waitForEvent('download');
+    await page.locator('#downloadButton').click();
+    const exportPath = path.join(artifacts, 'settings.json');
+    await (await downloaded).saveAs(exportPath);
+    assert.equal(JSON.parse(await fs.readFile(exportPath, 'utf8')).tasks[0].capture.outputFolder, chosen);
+    await page.screenshot({ path: path.join(artifacts, 'automatic-folder.png'), fullPage: true });
+    console.log('Real Windows editor-host integration passed: authenticated loopback request, automatic full-path fill, cancellation, JSON export, and cross-origin rejection.');
+  } finally {
+    if (browser) await browser.close();
+    harness.stdin.end('\n');
+    harness.kill();
+  }
+}
+
+main().catch(error => { console.error(error); process.exitCode = 1; });
diff --git a/tests/cases/save-settings/editor.e2e.cjs b/tests/cases/save-settings/editor.e2e.cjs
new file mode 100644
index 0000000..79957a4
--- /dev/null
+++ b/tests/cases/save-settings/editor.e2e.cjs
@@ -0,0 +1,131 @@
+'use strict';
+
+const assert = require('node:assert/strict');
+const path = require('node:path');
+const { pathToFileURL } = require('node:url');
+const { chromium } = require(process.env.PLAYWRIGHT_MODULE || 'playwright');
+
+async function main() {
+  const browser = await chromium.launch({ headless: true, executablePath: process.env.CHROME_PATH || undefined });
+  try {
+    const page = await browser.newPage({ acceptDownloads: true });
+    let downloads = 0;
+    page.on('download', () => downloads++);
+    await page.goto(pathToFileURL(path.resolve(__dirname, '../../../src/ScheduledScreenshot/config-editor.html')).href);
+    const save = page.locator('#saveButton');
+    const alert = page.locator('#errorBox');
+    await save.click();
+    assert.match(await alert.textContent(), /Open settings/);
+    assert.equal(downloads, 0);
+
+    // Model the browser's file handle and transactional writable stream, not a download.
+    await page.evaluate(() => {
+      window.savedFile = JSON.stringify({ schemaVersion: 1, tasks: [] });
+      window.writeCount = 0;
+      window.abortCount = 0;
+      window.saveFailure = '';
+      window.currentHandle = {
+        getFile: async () => new File([window.savedFile], 'settings.json', { type: 'application/json' }),
+        createWritable: async () => {
+          if (window.saveFailure === 'permission') throw new DOMException('Write access denied', 'NotAllowedError');
+          if (window.changeDuring === 'permission') window.savedFile = window.externalContents;
+          let pending;
+          return {
+            write: async value => {
+              if (window.saveFailure === 'write') throw new Error('Disk is full');
+              pending = value;
+              if (window.changeDuring === 'write') window.savedFile = window.externalContents;
+            },
+            close: async () => { window.savedFile = pending; window.writeCount++; },
+            abort: async () => { window.abortCount++; }
+          };
+        }
+      };
+      window.showOpenFilePicker = async () => [window.currentHandle];
+    });
+    await page.locator('#openButton').click();
+    await page.waitForFunction(() => document.getElementById('fileState').textContent.includes('update this file directly'));
+    await page.locator('#addTask').click();
+    await page.locator('#task-name').fill('Saved to original file');
+    await save.click();
+    await page.waitForFunction(() => window.writeCount === 1);
+    assert.equal(await page.evaluate(() => JSON.parse(window.savedFile).tasks[0].name), 'Saved to original file');
+    assert.match(await page.locator('#fileState').textContent(), /settings.json saved/);
+    assert.equal(downloads, 0);
+
+    // Failed opening must not bind the existing edits to a different, unreadable file.
+    await page.evaluate(() => {
+      window.showOpenFilePicker = async () => [{
+        getFile: async () => new File(['invalid json'], 'broken.json'),
+        createWritable: async () => { throw new Error('Wrong file was targeted'); }
+      }];
+    });
+    await page.locator('#openButton').click();
+    await page.waitForFunction(() => document.getElementById('errorBox').textContent.includes('Unable to load JSON'));
+    await save.click();
+    await page.waitForFunction(() => window.writeCount === 2);
+
+    for (const failure of ['permission', 'write']) {
+      await page.evaluate(value => { window.saveFailure = value; }, failure);
+      await save.click();
+      await page.waitForFunction(() => document.getElementById('errorBox').textContent.includes('Unable to update settings.json'));
+      assert.equal(await page.evaluate(() => window.writeCount), 2);
+      assert.equal(await save.isEnabled(), true);
+      assert.equal(downloads, 0);
+    }
+    assert.equal(await page.evaluate(() => window.abortCount), 1);
+
+    // Preserve application changes made before saving or while permission/write is pending.
+    for (const phase of ['before', 'permission', 'write']) {
+      await page.evaluate(() => {
+        window.saveFailure = '';
+        window.changeDuring = '';
+        window.showOpenFilePicker = async () => [window.currentHandle];
+      });
+      await page.locator('#openButton').click();
+      await page.waitForFunction(() => document.getElementById('fileState').textContent.includes('update this file directly'));
+      await page.locator('#taskNav [data-select]').nth(1).click();
+      await page.locator('#task-name').fill('Unsaved draft');
+      await page.evaluate(value => {
+        const external = JSON.parse(window.savedFile);
+        external.paused = true;
+        external.tasks[0].enabled = false;
+        external.tasks[0].name = `External edit ${value}`;
+        window.externalContents = JSON.stringify(external);
+        window.changeDuring = value;
+        if (value === 'before') window.savedFile = window.externalContents;
+      }, phase);
+      await save.click();
+      await page.waitForFunction(() => document.getElementById('errorBox').textContent.includes('changed outside this editor'));
+      assert.equal(await page.evaluate(() => window.savedFile === window.externalContents), true);
+      assert.equal(await page.evaluate(() => window.writeCount), 2);
+      assert.equal(await page.locator('#task-name').inputValue(), 'Unsaved draft');
+      assert.equal(await save.isEnabled(), true);
+    }
+    assert.equal(await page.evaluate(() => window.abortCount), 3);
+
+    // Importing via a standard file input must discard the previous write handle.
+    await page.locator('#fileInput').setInputFiles({
+      name: 'other-settings.json', mimeType: 'application/json',
+      buffer: Buffer.from(JSON.stringify({ schemaVersion: 1, tasks: [] }))
+    });
+    await page.waitForFunction(() => document.getElementById('fileState').textContent.startsWith('other-settings.json loaded'));
+    await save.click();
+    assert.match(await alert.textContent(), /Use Open settings/);
+    assert.equal(await page.evaluate(() => window.writeCount), 2);
+    await page.evaluate(() => { window.showOpenFilePicker = undefined; });
+    await save.click();
+    assert.match(await alert.textContent(), /cannot update local files directly/);
+    assert.equal(downloads, 0);
+
+    const exported = page.waitForEvent('download');
+    await page.locator('#downloadButton').click();
+    assert.equal((await exported).suggestedFilename(), 'settings.json');
+    assert.equal(downloads, 1);
+    console.log('Save settings checks passed: original-file writes, failed-open isolation, permission/write failures, external-change conflicts, imported-file isolation, unsupported browser, and separate export.');
+  } finally {
+    await browser.close();
+  }
+}
+
+main().catch(error => { console.error(error); process.exitCode = 1; });
diff --git a/tests/cases/scheduler/RuntimeHarness.cs b/tests/cases/scheduler/RuntimeHarness.cs
new file mode 100644
index 0000000..5dad2ea
--- /dev/null
+++ b/tests/cases/scheduler/RuntimeHarness.cs
@@ -0,0 +1,102 @@
+using System;
+using System.Collections;
+using System.Collections.Concurrent;
+using System.Drawing;
+using System.IO;
+using System.Linq;
+using System.Reflection;
+using System.Threading;
+using System.Windows.Forms;
+
+// Run the built configuration, scheduler, and capture services in an isolated directory.
+// This does not start a tray instance or alter the running application's settings.
+public static class RuntimeHarness
+{
+    private sealed class PumpContext : SynchronizationContext
+    {
+        private readonly ConcurrentQueue<Action> queue = new ConcurrentQueue<Action>();
+        public override void Post(SendOrPostCallback callback, object state)
+        {
+            queue.Enqueue(() => callback(state));
+        }
+        public void Drain()
+        {
+            Action action;
+            while (queue.TryDequeue(out action)) action();
+        }
+    }
+
+    private static object Create(Assembly assembly, string name, params object[] args)
+    {
+        return Activator.CreateInstance(assembly.GetType("ScheduledScreenshot.Services." + name, true), args);
+    }
+
+    private static object Get(object value, string name)
+    {
+        return value.GetType().GetProperty(name).GetValue(value);
+    }
+
+    private static void Check(bool condition, string message)
+    {
+        if (!condition) throw new Exception(message);
+    }
+
+    [STAThread]
+    public static void Main(string[] args)
+    {
+        var assembly = Assembly.LoadFrom(Path.GetFullPath(args[0]));
+        var directory = Path.Combine(Path.GetTempPath(), "ScheduledScreenshot-regression-" + Guid.NewGuid().ToString("N"));
+        Directory.CreateDirectory(directory);
+        try
+        {
+            var tasks = new[] { "jpeg", "png", "expired-1", "expired-2" }.Select(name =>
+                "{\"id\":\"" + Guid.NewGuid() + "\",\"name\":\"" + name + "\",\"enabled\":true," +
+                "\"capture\":{\"outputFolder\":\"" + name + "\",\"imageFormat\":\"" + (name == "png" ? "png" : "jpeg") + "\"}," +
+                "\"schedule\":{\"intervalSeconds\":1},\"stopCondition\":" +
+                (name.StartsWith("expired") ? "{\"mode\":\"at\",\"endAtLocal\":\"2020-01-01T00:00:00\"}" : "{\"mode\":\"count\",\"captureCount\":1}") + "}");
+            File.WriteAllText(Path.Combine(directory, "settings.json"), "{\"tasks\":[" + string.Join(",", tasks) + "]}");
+            var context = new PumpContext();
+            using (var logger = (IDisposable)Create(assembly, "DiagnosticLogger", directory))
+            {
+                using (var configuration = (IDisposable)Create(assembly, "ConfigurationService", directory, logger, context))
+                {
+                    Check(((IEnumerable)Get(Get(configuration, "Current"), "tasks")).Cast<object>().Count() == 4, "Expired tasks invalidated startup.");
+                    var state = Create(assembly, "RuntimeStateStore", directory, logger);
+                    var capture = Create(assembly, "CaptureCoordinator", directory, logger);
+                    using (var scheduler = (IDisposable)Create(assembly, "SchedulerService", configuration, state, capture, logger))
+                    {
+                        var finish = DateTime.UtcNow.AddSeconds(6);
+                        while (DateTime.UtcNow < finish) { context.Drain(); Thread.Sleep(20); }
+                        context.Drain();
+                        var current = Get(configuration, "Current");
+                        Check(!(bool)Get(current, "paused"), "Startup unexpectedly paused all tasks.");
+                        Check(((IEnumerable)Get(current, "tasks")).Cast<object>().All(task => !(bool)Get(task, "enabled")), "Expired/count-limited tasks did not stop.");
+                    }
+                }
+                using (var restarted = (IDisposable)Create(assembly, "ConfigurationService", directory, logger, context))
+                {
+                    Check(((IEnumerable)Get(Get(restarted, "Current"), "tasks")).Cast<object>().Count() == 4, "Restart lost settings.");
+                }
+            }
+            foreach (var format in new[] { "jpeg", "png" })
+            {
+                var files = Directory.GetFiles(Path.Combine(directory, format), "*.*", SearchOption.AllDirectories);
+                Check(files.Length == Screen.AllScreens.Length, "Expected exactly one " + format + " image per monitor.");
+                foreach (var file in files)
+                    using (var image = Image.FromFile(file)) Check(image.Width > 0 && image.Height > 0, "Invalid screenshot.");
+            }
+            foreach (var name in new[] { "expired-1", "expired-2" })
+                Check(Directory.GetFiles(Path.Combine(directory, name), "*.*", SearchOption.AllDirectories).Length == 0, "Expired task captured an image.");
+            var logs = string.Join("\n", Directory.GetFiles(Path.Combine(directory, "logs"), "*.jsonl").Select(File.ReadAllText));
+            foreach (var failure in new[] { "SCHEDULER_ERROR", "CAPTURE_PROFILE_FAILED", "CONFIG_REJECTED" })
+                Check(!logs.Contains(failure), "Unexpected runtime failure: " + failure);
+            Console.WriteLine("Runtime regression passed: simultaneous expiration, JPEG/PNG scheduled captures, count completion, no duplicate images, and settings preserved after restart.");
+        }
+        finally
+        {
+            // This path is generated above as a unique child of the system temporary directory.
+            var tempRoot = Path.GetFullPath(Path.GetTempPath()).TrimEnd(Path.DirectorySeparatorChar) + Path.DirectorySeparatorChar;
+            if (Path.GetFullPath(directory).StartsWith(tempRoot, StringComparison.OrdinalIgnoreCase)) Directory.Delete(directory, true);
+        }
+    }
+}
