@@ -0,0 +1,51 @@
+'use strict';
+
+const assert = require('node:assert/strict');
+const path = require('node:path');
+const { pathToFileURL } = require('node:url');
+const { chromium } = require(process.env.PLAYWRIGHT_MODULE || 'playwright');
+
+async function main() {
+  const browser = await chromium.launch({ headless: true, executablePath: process.env.CHROME_PATH || undefined });
+  try {
+    const page = await browser.newPage();
+    await page.goto(pathToFileURL(path.resolve(__dirname, '../../../src/ScheduledScreenshot/config-editor.html')).href);
+    const importSettings = async value => {
+      await page.locator('#fileInput').setInputFiles({ name: 'settings.json', mimeType: 'application/json', buffer: Buffer.from(JSON.stringify(value)) });
+    };
+    const markup = '<img src=x onerror="window.reviewInjected=true">';
+    await page.locator('#addTask').click();
+    await page.locator('#task-name').fill('Keep my draft');
+    for (const value of [
+      { tasks: [{ schedule: { intervalSeconds: markup } }] },
+      { tasks: [{ schedule: { times: [{}] } }] },
+      { tasks: [{ stopCondition: { captureCount: markup } }] },
+      { tasks: [null] },
+      { tasks: {} },
+      { logging: [] },
+      { paused: 'false' },
+      []
+    ]) {
+      await importSettings(value);
+      await page.waitForFunction(() => document.getElementById('errorBox').textContent.includes('Unable to load JSON'));
+      assert.equal(await page.locator('#task-name').inputValue(), 'Keep my draft');
+      assert.equal(await page.evaluate(() => window.reviewInjected), undefined);
+      assert.equal(await page.locator('img').count(), 0);
+    }
+    // Legitimate string fields remain editable text; expired tasks remain exportable.
+    await importSettings({ tasks: [{ name: markup, enabled: true, stopCondition: { mode: 'at', endAtLocal: '2020-01-01T00:00:00' } }] });
+    await page.waitForFunction(() => document.getElementById('fileState').textContent.startsWith('settings.json loaded'));
+    await page.locator('#taskNav [data-select]').nth(1).click();
+    assert.equal(await page.locator('#task-name').inputValue(), markup);
+    assert.equal(await page.locator('img').count(), 0);
+    const download = page.waitForEvent('download');
+    await page.locator('#downloadButton').click();
+    assert.equal((await download).suggestedFilename(), 'settings.json');
+    assert.equal(await page.evaluate(() => window.reviewInjected), undefined);
+    console.log('Import safety checks passed: malformed types rejected, drafts preserved, markup rendered as text, and expired tasks accepted.');
+  } finally {
+    await browser.close();
+  }
+}
+
+main().catch(error => { console.error(error); process.exitCode = 1; });
