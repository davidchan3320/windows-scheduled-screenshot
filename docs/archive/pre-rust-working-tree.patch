@@ -0,0 +1,23 @@
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using ScheduledScreenshot.Models;
+
+namespace ScheduledScreenshot.Services
+{
+    // Accessed under the scheduler lock. Each armed occurrence can be taken only once.
+    internal sealed class PendingOccurrences
+    {
+        private readonly List<TaskOccurrence> _items = new List<TaskOccurrence>();
+
+        public void Clear() => _items.Clear();
+        public void Add(TaskOccurrence occurrence) => _items.Add(occurrence);
+
+        public List<TaskOccurrence> TakeDue(DateTimeOffset nowUtc)
+        {
+            var due = _items.Where(item => item.DueUtc <= nowUtc).ToList();
+            _items.RemoveAll(item => item.DueUtc <= nowUtc);
+            return due;
+        }
+    }
+}
